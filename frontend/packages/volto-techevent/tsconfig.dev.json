{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@plone/volto/*": ["../../core/packages/volto/src/*"],
      "@plone-collective/volto-techevent/*": ["./src/*"],
      "@plonegovbr/volto-social-media/*": [
        "./node_modules/@plonegovbr/volto-social-media/src/*"
      ]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx"],
  "exclude": ["node_modules", "build", "public", "coverage"]
}
