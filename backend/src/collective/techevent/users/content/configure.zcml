<configure xmlns="http://namespaces.zope.org/zope">

  <adapter
      factory="plone.app.dexterity.behaviors.exclfromnav.default_exclude_true"
      for=".attendee.IAttendee"
      />
  <adapter
      factory="plone.app.dexterity.behaviors.exclfromnav.default_exclude_true"
      for=".ticket.ITicket"
      />

  <!-- Attendees are named with registration codes -->
  <adapter
      factory="collective.techevent.users.code.AttendeeNameChooser"
      provides="zope.container.interfaces.INameChooser"
      for=".attendees.IAttendees"
      />

  <!-- Indexers -->
  <adapter
      factory=".indexers.attendee_email_indexer"
      name="attendee_email"
      />
  <adapter
      factory=".indexers.attendee_user_id_indexer"
      name="attendee_user_id"
      />

  <!-- Subscribers -->
  <subscriber
      for=".attendees.IAttendees
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".subscribers.impose_limit"
      />
  <subscriber
      for=".attendees.IAttendees
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".subscribers.registration_page"
      />
  <subscriber
      for=".attendee.IAttendee
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".subscribers.confirm_automatically"
      />
  <subscriber
      for=".attendee.IAttendee
           Products.CMFCore.interfaces.IActionSucceededEvent"
      handler=".subscribers.confirmed"
      />

</configure>
