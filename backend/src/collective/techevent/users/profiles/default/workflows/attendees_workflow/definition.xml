<?xml version="1.0" encoding="utf-8"?>
<dc-workflow xmlns:i18n="http://xml.zope.org/namespaces/i18n"
             description="Registration period of an event: set up, open, or closed. The database is public once opened; only organizers see its registrations."
             initial_state="created"
             state_variable="review_state"
             title="Attendees Workflow"
             workflow_id="attendees_workflow"
             i18n:attributes="title; description"
             i18n:domain="collective.techevent"
>

  <permission>View</permission>
  <permission>Access contents information</permission>
  <permission>Modify portal content</permission>

  <state state_id="created"
         title="Created"
         i18n:attributes="title"
  >
    <description i18n:translate="">Set up, not taking registrations yet.</description>
    <exit-transition transition_id="open" />
    <permission-map acquired="False"
                    name="View"
    >
      <permission-role>Owner</permission-role>
      <permission-role>Reviewer</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Manager</permission-role>
      <permission-role>Site Administrator</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Access contents information"
    >
      <permission-role>Owner</permission-role>
      <permission-role>Reviewer</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Manager</permission-role>
      <permission-role>Site Administrator</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Modify portal content"
    >
      <permission-role>Owner</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Manager</permission-role>
      <permission-role>Site Administrator</permission-role>
    </permission-map>
  </state>

  <state state_id="open"
         title="Open"
         i18n:attributes="title"
  >
    <description i18n:translate="">Taking registrations, until the registration deadline if there is one.</description>
    <exit-transition transition_id="close" />
    <permission-map acquired="False"
                    name="View"
    >
      <permission-role>Anonymous</permission-role>
      <permission-role>Owner</permission-role>
      <permission-role>Reviewer</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Manager</permission-role>
      <permission-role>Site Administrator</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Access contents information"
    >
      <permission-role>Anonymous</permission-role>
      <permission-role>Owner</permission-role>
      <permission-role>Reviewer</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Manager</permission-role>
      <permission-role>Site Administrator</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Modify portal content"
    >
      <permission-role>Owner</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Manager</permission-role>
      <permission-role>Site Administrator</permission-role>
    </permission-map>
  </state>

  <state state_id="closed"
         title="Closed"
         i18n:attributes="title"
  >
    <description i18n:translate="">Registration period over.</description>
    <exit-transition transition_id="open" />
    <permission-map acquired="False"
                    name="View"
    >
      <permission-role>Anonymous</permission-role>
      <permission-role>Owner</permission-role>
      <permission-role>Reviewer</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Manager</permission-role>
      <permission-role>Site Administrator</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Access contents information"
    >
      <permission-role>Anonymous</permission-role>
      <permission-role>Owner</permission-role>
      <permission-role>Reviewer</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Manager</permission-role>
      <permission-role>Site Administrator</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Modify portal content"
    >
      <permission-role>Owner</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Manager</permission-role>
      <permission-role>Site Administrator</permission-role>
    </permission-map>
  </state>

  <transition after_script=""
              before_script=""
              new_state="open"
              title="Open registration"
              transition_id="open"
              trigger="USER"
              i18n:attributes="title"
  >
    <action category="workflow"
            url="%(content_url)s/content_status_modify?workflow_action=open"
            i18n:translate=""
    >Open registration</action>
    <guard>
      <guard-permission>Review portal content</guard-permission>
    </guard>
  </transition>

  <transition after_script=""
              before_script=""
              new_state="closed"
              title="Close registration"
              transition_id="close"
              trigger="USER"
              i18n:attributes="title"
  >
    <action category="workflow"
            url="%(content_url)s/content_status_modify?workflow_action=close"
            i18n:translate=""
    >Close registration</action>
    <guard>
      <guard-permission>Review portal content</guard-permission>
    </guard>
  </transition>

  <variable for_catalog="False"
            for_status="True"
            update_always="True"
            variable_id="action"
  >
    <default>
      <expression>transition/getId|nothing</expression>
    </default>
    <guard>
</guard>
  </variable>

  <variable for_catalog="False"
            for_status="True"
            update_always="True"
            variable_id="actor"
  >
    <default>
      <expression>user/getId</expression>
    </default>
    <guard>
</guard>
  </variable>

  <variable for_catalog="False"
            for_status="True"
            update_always="True"
            variable_id="comments"
  >
    <default>
      <expression>python:state_change.kwargs.get('comment', '')</expression>
    </default>
    <guard>
</guard>
  </variable>

  <variable for_catalog="False"
            for_status="False"
            update_always="False"
            variable_id="review_history"
  >
    <default>
      <expression>state_change/getHistory</expression>
    </default>
    <guard>
      <guard-permission>Request review</guard-permission>
      <guard-permission>Review portal content</guard-permission>
    </guard>
  </variable>

  <variable for_catalog="False"
            for_status="True"
            update_always="True"
            variable_id="time"
  >
    <default>
      <expression>state_change/getDateTime</expression>
    </default>
    <guard>
</guard>
  </variable>
</dc-workflow>
