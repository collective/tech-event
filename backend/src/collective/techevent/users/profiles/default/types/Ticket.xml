<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        meta_type="Dexterity FTI"
        name="Ticket"
        i18n:domain="collective.techevent"
>

  <!-- Basic properties -->
  <property name="title"
            i18n:translate=""
  >Ticket</property>
  <property name="description"
            i18n:translate=""
  >A ticket registrants can choose for an event.</property>

  <property name="allow_discussion">False</property>
  <property name="factory">Ticket</property>
  <property name="icon_expr" />
  <property name="link_target" />

  <!-- Hierarchy control -->
  <property name="global_allow">False</property>
  <property name="filter_content_types">True</property>
  <property name="allowed_content_types" />

  <!-- Schema, class and security -->
  <property name="add_permission">collective.techevent.AddTicket</property>
  <property name="klass">collective.techevent.users.content.ticket.Ticket</property>
  <property name="model_file" />
  <property name="model_source" />
  <property name="schema">collective.techevent.users.content.ticket.ITicket</property>

  <!-- Enabled behaviors -->
  <property name="behaviors"
            purge="false"
  >
    <element value="plone.basic" />
    <element value="plone.namefromtitle" />
  </property>


</object>
